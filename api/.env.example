# FitTrack PT - Ortam Değişkenleri
NODE_ENV=development
PORT=3000

# Veritabanı (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=fittrack_user
DB_PASSWORD=fittrack_secure_password_2026!
DB_NAME=fittrack_db
DB_SSL=false

# JWT Yapılandırması
JWT_ACCESS_SECRET=fittrack_jwt_access_super_secret_key_2026_x99!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=fittrack_jwt_refresh_super_secret_key_2026_r77!
JWT_REFRESH_EXPIRES_IN=7d

# Hız Sınırlama (Throttler / Rate Limit)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Varsayılan Salon & Admin Tohum (Seed) Bilgileri
SEED_SALON_NAME="FitTrack Merkez Spor Salonu"
SEED_SALON_SLUG="fittrack-merkez"
SEED_ADMIN_EMAIL=admin@fittrack.com
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_ADMIN_FIRST_NAME=Sistem
SEED_ADMIN_LAST_NAME=Yöneticisi
SEED_ADMIN_PHONE=+905551112233
